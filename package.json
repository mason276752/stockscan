{
  "name": "stockscan",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Node.js server that scrapes SEC Inline XBRL filings and serves the primary financial statements as JSON",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "build:web": "npm --prefix web run build",
    "postinstall": "npm --prefix web install",
    "build:static": "node server/tools/build-static.mjs",
    "data:pull": "sh scripts/pull-data.sh",
    "data:push": "node server/tools/push-data.mjs",
    "fetch:new": "node server/tools/fetch-new.mjs",
    "ingest:dera": "node server/tools/ingest-dera.mjs",
    "rescore": "node server/tools/rescore.mjs",
    "enrich:cover-shares": "node server/tools/enrich-cover-shares.mjs",
    "fetch:bars": "node server/tools/fetch-bars.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@stoqey/ib": "^1.6.9",
    "cheerio": "^1.0.0",
    "express": "^4.21.0"
  }
}
