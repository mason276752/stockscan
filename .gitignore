node_modules/
web/dist/
*.log
.env
# data/store (財報與評分) 與 data/bars (日線) 進 git；cache.sqlite 與舊的 SQLite 不進
# （git 不能 re-include 被排除目錄底下的檔案，所以要寫 data/* 而不是 data/）
data/*
!data/store/
!data/bars/
data/store/**/*.tmp
data/bars/**/*.tmp
# 今年還在長的日線檔：每天都變，不進 git（Pages 的 workflow 自己抓，本機 server 自己補）
data/bars/**/head.zst
web/dist-static/
